call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_complete_endpoint');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_embed_endpoint');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_rerank_endpoint');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_ollama_complete_endpoint');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_ollama_embed_endpoint');
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_complete_model');
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_embed_model');
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_rerank_model');
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_ollama_complete_model');
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_ollama_embed_model');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
'enhance_complete_model',
'{"type":"completion","model_name":"mock-completion"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
'enhance_complete_endpoint',
'{"ai_model_name":"enhance_complete_model","url":"http://127.0.0.1:8000/v1/chat/completions","access_key":"mock-key","provider":"openai","request_model_name":"mock-completion"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
'enhance_embed_model',
'{"type":"dense_embedding","model_name":"mock-embed"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
'enhance_embed_endpoint',
'{"ai_model_name":"enhance_embed_model","url":"http://127.0.0.1:8000/v1/embeddings","access_key":"mock-key","provider":"openai","request_model_name":"mock-embed"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
'enhance_rerank_model',
'{"type":"rerank","model_name":"mock-rerank"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
'enhance_rerank_endpoint',
'{"ai_model_name":"enhance_rerank_model","url":"http://127.0.0.1:8000/rerank","access_key":"mock-key","provider":"siliconflow","request_model_name":"mock-rerank"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
'enhance_ollama_complete_model',
'{"type":"completion","model_name":"ollama-completion"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
'enhance_ollama_complete_endpoint',
'{"ai_model_name":"enhance_ollama_complete_model","url":"http://127.0.0.1:8000/api/generate","provider":"ollama","access_key":"","request_model_name":"ollama-completion"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
'enhance_ollama_embed_model',
'{"type":"dense_embedding","model_name":"ollama-embed"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
'enhance_ollama_embed_endpoint',
'{"ai_model_name":"enhance_ollama_embed_model","url":"http://127.0.0.1:8000/api/embed","provider":"ollama","access_key":"","request_model_name":"ollama-embed"}');
select json_length(ai_prompt('{0}/{0}', json_array('nested', 2))) = 2;
json_length(ai_prompt('{0}/{0}', json_array('nested', 2))) = 2
1
select length(ai_complete('enhance_complete_model', 'plain prompt', NULL)) > 0;
length(ai_complete('enhance_complete_model', 'plain prompt', NULL)) > 0
1
select length(ai_complete(
'enhance_complete_model',
ai_prompt('Answer {0}', json_object('question', 'hello')),
json_object('temperature', 0.25, 'max_tokens', 16))) > 0;
length(ai_complete(
'enhance_complete_model',
ai_prompt('Answer {0}', json_object('question', 'hello')),
json_object('temperature', 0.25, 'max_tokens', 16))) > 0
1
drop table if exists enhance_complete_prompts;
create table enhance_complete_prompts (prompt longtext);
insert into enhance_complete_prompts values (repeat('long prompt ', 256));
select length(ai_complete(
'enhance_complete_model',
prompt,
'{"temperature":0.25,"max_tokens":16}')) > 0
from enhance_complete_prompts;
length(ai_complete(
'enhance_complete_model',
prompt,
'{"temperature":0.25,"max_tokens":16}')) > 0
1
drop table enhance_complete_prompts;
select length(ai_embed('enhance_embed_model', 'item-42')) > 0;
length(ai_embed('enhance_embed_model', 'item-42')) > 0
